{
  "name": "royale-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx server/selftest.ts && tsx server/robusttest.ts && tsx server/ludotest.ts && tsx server/aitest.ts && tsx server/reviewstest.ts && tsx server/profilestest.ts",
    "icons": "node scripts/make-icons.mjs",
    "test:robust": "tsx server/robusttest.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
