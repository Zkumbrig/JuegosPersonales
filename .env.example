# Copia este archivo como .env (no se sube a git) y rellena lo que uses.
# Frases nuevas con IA para los juegos de fiesta (clave gratuita en https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Opcionales:
# GEMINI_MODEL=gemini-2.5-flash
# AI_CONTENT=0   # desactiva la IA y usa solo la lista curada

# Reseñas privadas de los jugadores (solo las lees tú).
# Postgres gratuito (Supabase o Neon): pega aquí la URL de conexión. Sin ella se guardan en un archivo local (solo desarrollo).
DATABASE_URL=
# Clave (mínimo 12 caracteres) para ver las reseñas en /admin/reviews?key=TU_CLAVE
ADMIN_KEY=
